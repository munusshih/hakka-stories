---
// Display stories like a flight departure dashboard
import fs from "fs";
import path from "path";

// Read the stories data
const rawStoriesData = JSON.parse(
  fs.readFileSync(
    path.join(process.cwd(), "src", "data", "stories.json"),
    "utf-8"
  )
);

// Convert absolute audio paths to relative paths
const storiesData = rawStoriesData.map((story) => ({
  ...story,
  "Audio File": story["Audio File"]?.startsWith("/audio/")
    ? "." + story["Audio File"]
    : story["Audio File"],
}));

// Read CSS files
const dashboardCSS = fs.readFileSync(
  path.join(process.cwd(), "src", "styles", "dashboard.css"),
  "utf-8"
);
const subtitlesCSS = fs.readFileSync(
  path.join(process.cwd(), "src", "styles", "subtitles.css"),
  "utf-8"
);
const carouselCSS = fs.readFileSync(
  path.join(process.cwd(), "src", "styles", "carousel.css"),
  "utf-8"
);

// Read script files
const cipherJS = fs
  .readFileSync(
    path.join(process.cwd(), "src", "scripts", "cipher.js"),
    "utf-8"
  )
  .replace(/^import .*/gm, "")
  .replace(/^export .*/gm, "");

const storyJS = fs
  .readFileSync(path.join(process.cwd(), "src", "scripts", "Story.js"), "utf-8")
  .replace(/^import .*/gm, "")
  .replace(/^export .*/gm, "");

const departureBoardJS = fs
  .readFileSync(
    path.join(process.cwd(), "src", "scripts", "DepartureBoard.js"),
    "utf-8"
  )
  .replace(/^import .*/gm, "")
  .replace(/^export .*/gm, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hakka Stories - Departure Board</title>
    <style set:html={dashboardCSS}></style>
    <style set:html={subtitlesCSS}></style>
    <style set:html={carouselCSS}></style>
    <script>
      // Safe GSAP loading with error handling
      window.gsapLoadError = false;
      window.addEventListener("error", function (e) {
        if (
          e.filename &&
          (e.filename.includes("gsap") || e.filename.includes("Flip"))
        ) {
          console.warn("GSAP loading error, falling back to CSS animations");
          window.gsapLoadError = true;
        }
      });
    </script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
      onerror="window.gsapLoadError = true; console.warn('GSAP failed to load');"
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/Flip.min.js"
      onerror="window.flipLoadError = true; console.warn('Flip failed to load');"
    ></script>
  </head>
  <body>
    <!-- Audio Unlock Popup -->
    <div id="audio-unlock-popup" class="audio-unlock-popup">
      <div class="popup-content">
        <h2>🎧 ENABLE AUDIO</h2>
        <p>Click to unlock audio and start the experience</p>
        <button id="audio-unlock-btn" class="popup-button"
          >CLICK TO BEGIN</button
        >
      </div>
    </div>

    <!-- Idle Screen -->
    <div id="idle-screen" class="idle-screen">
      <div class="idle-content">
        <p>CLOSED</p>
        <p>Experience will resume at 8:00 AM</p>
      </div>
    </div>

    <div class="departure-board">
      <header class="board-header">
        <h1>GUEST STOP (IN TRANSIT)</h1>
      </header>

      <div class="board-columns">
        <div class="column-header">TIME</div>
        <div class="column-header">DESTINATION</div>
        <div class="column-header">FLIGHT</div>
        <div class="column-header">STATUS</div>
      </div>

      <div class="stories-list">
        <!-- Stories will be populated by JavaScript -->
      </div>
    </div>

    <!-- Carousel Templates -->
    <template id="carousel-mode-1">
      <div class="carousel-grid carousel-mode-1">
        <div class="carousel-screen carousel-left">
          <div class="carousel-label">FROM</div>
          <div class="carousel-text" data-field="fromLocation"></div>
          <div class="carousel-text-chinese" data-field="fromLocationChinese">
          </div>
        </div>
        <div class="carousel-screen carousel-center">
          <div class="carousel-arrow"><--></div>
        </div>
        <div class="carousel-screen carousel-right">
          <div class="carousel-label">TO</div>
          <div class="carousel-text" data-field="toLocation"></div>
          <div class="carousel-text-chinese" data-field="toLocationChinese">
          </div>
        </div>
      </div>
    </template>

    <template id="carousel-mode-2">
      <div class="carousel-grid carousel-mode-2">
        <div class="carousel-screen carousel-left"></div>
        <div class="carousel-screen carousel-center">
          <!-- <div class="carousel-label">FROM</div> -->
          <div class="carousel-text" data-field="fromLocation"></div>
          <div class="carousel-text-chinese" data-field="fromLocationChinese">
          </div>
          <div class="carousel-arrow"><--></div>
          <!-- <div class="carousel-label">TO</div> -->
          <div class="carousel-text" data-field="toLocation"></div>
          <div class="carousel-text-chinese" data-field="toLocationChinese">
          </div>
        </div>
        <div class="carousel-screen carousel-right"></div>
      </div>
    </template>

    <template id="carousel-mode-3">
      <div class="carousel-grid carousel-mode-3">
        <div class="carousel-screen carousel-left">
          <div class="carousel-label">FROM</div>
          <div class="carousel-text" data-field="fromLocation"></div>
          <div class="carousel-text-chinese" data-field="fromLocationChinese">
          </div>
        </div>
        <div class="carousel-screen carousel-center">
          <div class="carousel-label">TO</div>
          <div class="carousel-text" data-field="toLocation"></div>
          <div class="carousel-text-chinese" data-field="toLocationChinese">
          </div>
        </div>
        <div class="carousel-screen carousel-right"></div>
      </div>
    </template>

    <script is:inline set:html={cipherJS} />
    <script is:inline set:html={storyJS} />
    <script is:inline set:html={departureBoardJS} />
    <script define:vars={{ storiesData }}>
      window.__STORIES_DATA__ = storiesData;

      // Audio context management for browser autoplay policy
      let audioUnlocked = false;
      let experienceInitialized = false;

      function unlockAudio() {
        if (audioUnlocked) return;
        const audioContext = new (
          window.AudioContext || window.webkitAudioContext
        )();
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        gainNode.gain.value = 0;
        oscillator.start();
        oscillator.stop();
        audioUnlocked = true;
        console.log("Audio unlocked - ready for playback");
      }

      function dismissAudioPopup() {
        const popup = document.getElementById("audio-unlock-popup");
        if (popup) {
          popup.classList.add("hidden");
        }
        unlockAudio();

        // Initialize experience after popup is dismissed
        if (!experienceInitialized) {
          initializeExperience();
        }
      }

      async function initializeExperience() {
        if (experienceInitialized) return;
        experienceInitialized = true;

        try {
          const board = new DepartureBoard();
          await board.initialize(storiesData);
          window.departureBoard = board;
        } catch (error) {
          console.error("Error initializing departure board:", error);
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        // Set up popup button handler
        const unlockBtn = document.getElementById("audio-unlock-btn");
        if (unlockBtn) {
          unlockBtn.addEventListener("click", dismissAudioPopup);
        }

        // Also allow pressing any key or clicking anywhere to dismiss
        document.addEventListener("keydown", dismissAudioPopup, { once: true });
      });
    </script>
  </body>
</html>
