---
// Display stories like a flight departure dashboard
import fs from "fs";
import path from "path";

// Read the stories data
const storiesData = JSON.parse(
  fs.readFileSync(
    path.join(process.cwd(), "src", "data", "stories.json"),
    "utf-8"
  )
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hakka Stories - Departure Board</title>
    <link rel="stylesheet" href="/src/styles/dashboard.css" />
    <link rel="stylesheet" href="/src/styles/subtitles.css" />
    <script>
      // Safe GSAP loading with error handling
      window.gsapLoadError = false;
      window.addEventListener("error", function (e) {
        if (
          e.filename &&
          (e.filename.includes("gsap") || e.filename.includes("Flip"))
        ) {
          console.warn("GSAP loading error, falling back to CSS animations");
          window.gsapLoadError = true;
        }
      });
    </script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
      onerror="window.gsapLoadError = true; console.warn('GSAP failed to load');"
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/Flip.min.js"
      onerror="window.flipLoadError = true; console.warn('Flip failed to load');"
    ></script>
  </head>
  <body>
    <div class="departure-board">
      <header class="board-header">
        <h1>GUEST STOP (IN TRANSIT)</h1>
      </header>

      <div class="board-columns">
        <div class="column-header">TIME</div>
        <div class="column-header">DESTINATION</div>
        <div class="column-header">FLIGHT</div>
        <div class="column-header">STATUS</div>
      </div>

      <div class="stories-list">
        <!-- Stories will be populated by JavaScript -->
      </div>
    </div>

    <script type="module" src="/src/scripts/main.js"></script>
  </body>
</html>
